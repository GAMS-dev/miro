{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "apiServerIp": {
              "type": "string"
            }
          },
          "required": ["enabled"],
          "dependencies": {
            "enabled": {
              "oneOf": [
                {
                  "properties": {
                    "enabled": {
                      "const": false
                    }
                  }
                },
                {
                  "properties": {
                    "enabled": {
                      "const": true
                    },
                    "apiServerIp": {
                      "minLength": 1
                    }
                  },
                  "required": ["apiServerIp"]
                }
              ]
            }
          }
        }
      },
      "required": ["networkPolicy"]
    },
    "db": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["port", "user", "password", "name"]
    }
  },
  "required": ["global", "db"]
}
